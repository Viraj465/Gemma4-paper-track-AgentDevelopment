


import os
import shutil
import subprocess

temp_repo_path = "/kaggle/working/repo_temp"
target_rl_envs = "/kaggle/working/rl-envs"
target_scripts = "/kaggle/working/scripts"

# Clone the repository
subprocess.run(
    ["git", "clone", "--depth", "1", "https://github.com/UKGovernmentBEIS/reward-hacking-misalignment.git", temp_repo_path],
    check=True
)

# Move required directories
if os.path.exists(os.path.join(temp_repo_path, "rl-envs")):
    shutil.move(os.path.join(temp_repo_path, "rl-envs"), target_rl_envs)

if os.path.exists(os.path.join(temp_repo_path, "scripts")):
    shutil.move(os.path.join(temp_repo_path, "scripts"), target_scripts)

# Clean up temporary cloned repository
shutil.rmtree(temp_repo_path, ignore_errors=True)

# Verification
print("\n--- VERIFICATION ---")
print("rl-envs:", "FOUND" if os.path.exists(target_rl_envs) else "MISSING")
print("scripts (evals):", "FOUND" if os.path.exists(target_scripts) else "MISSING")



import json
from datasets import load_dataset

DATA_DIR = "/kaggle/working/data/tier2"
os.makedirs(DATA_DIR, exist_ok=True)

print("--- 1. Pulling MBPP+ / EvalPlus (Sound Golden Baseline) ---")
# MBPP+ provides expanded, sound test suites to test honest vs exploited functional correctness
mbpp_plus = load_dataset("evalplus/mbppplus", split="test")
mbpp_save_path = os.path.join(DATA_DIR, "mbpp_plus.jsonl")
mbpp_plus.to_json(mbpp_save_path)
print(f"Saved {len(mbpp_plus)} MBPP+ samples to {mbpp_save_path}")


print("\n--- 2. Pulling SpecBench Repo & Problem Suites ---")
specbench_temp = "/kaggle/working/specbench_temp"
specbench_target = os.path.join(DATA_DIR, "specbench")

subprocess.run([
    "git", "clone", "--depth", "1",
    "https://github.com/ml-research/llms-gaming-verifiers.git",
    specbench_temp
], check=False)

# If the alternate official upstream repo is used:
if not os.path.exists(specbench_temp):
    subprocess.run([
        "git", "clone", "--depth", "1",
        "https://github.com/MajoRoth/hack-verifiable-environments.git",
        specbench_temp
    ], check=True)

# Move tasks, test suites, and harness logic into Tier 2 directory
if os.path.exists(specbench_temp):
    import shutil
    shutil.move(specbench_temp, specbench_target)
    print(f"Cloned SpecBench environments to {specbench_target}")


print("\n--- 3. Verifying Tier 2 Dataset Assets ---")
print("MBPP+ present:", os.path.exists(mbpp_save_path))
print("SpecBench present:", os.path.exists(specbench_target))
print(f"All Tier 2 datasets ready in: {DATA_DIR}")








